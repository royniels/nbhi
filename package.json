{
  "name": "nbhi",
  "version": "1.0.1",
  "description": "Web components from plain HTML templates, without build tools. Bindings in a template become properties, rows() renders lists, and a component with a form field is a real form control.",
  "keywords": [
    "web-components",
    "custom-elements",
    "html-templates",
    "html-includes",
    "no-build",
    "buildless",
    "data-binding",
    "list-rendering",
    "form-associated",
    "form-controls",
    "shadow-dom",
    "vanilla-js"
  ],
  "homepage": "https://royniels.github.io/nbhi/",
  "bugs": {
    "url": "https://github.com/royniels/nbhi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royniels/nbhi.git"
  },
  "files": [
    "./javascript/**.js"
  ],
  "exports": {
    ".": "./javascript/index.js"
  },
  "license": "MIT",
  "author": "Roy Niels",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "site": "node site/serve.js",
    "art": "node site/art/draw.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
