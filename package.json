{
  "name": "nbhi",
  "version": "1.0.0",
  "description": "No-Build HTML Includes (NBHI) turns HTML templates, in their own files or in the page, into web components. The template's bindings become properties, rows() renders lists, and a component with a form field is a real form control. No build tools required.",
  "keywords": [
    "web-components",
    "html-includes",
    "no-build",
    "data-binding",
    "form-associated",
    "mpa",
    "multi-page-application",
    "composable"
  ],
  "homepage": "https://github.com/royniels/nbhi#readme",
  "bugs": {
    "url": "https://github.com/royniels/nbhi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royniels/nbhi.git"
  },
  "files": [
    "./javascript/**.js"
  ],
  "exports": {
    ".": "./javascript/index.js"
  },
  "license": "MIT",
  "author": "Roy Niels",
  "type": "module",
  "scripts": {
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
